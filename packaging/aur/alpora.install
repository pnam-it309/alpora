post_install() {
    cat <<'EOF'
:: ALPORA has been installed successfully!
:: To start ALPORA in your current Hyprland/Wayland session:
     poly-shell start

:: To preview themes and current system configuration:
     alpora-fetch

:: To manage shortcuts, wallpapers, and settings:
     poly-shell settings

:: To make ALPORA your primary default shell with automatic session management:
     poly-shell activate
EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: ALPORA has been removed. You can restore your previous shell config with 'poly-shell deactivate' if backed up."
}

