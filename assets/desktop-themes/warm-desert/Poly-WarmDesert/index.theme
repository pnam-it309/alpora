[Icon Theme]
Name=Тёплая пустыня
Comment=Faceted Alpine folders with inherited application icons
Inherits=Papirus-Dark,Adwaita,hicolor
Directories=scalable/places,scalable/apps

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
