#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"
qml_linter="${QMLLINT:-/usr/lib/qt6/bin/qmllint}"
for dependency in python3 node quickshell cc; do
    if ! command -v "$dependency" >/dev/null; then
        echo "Missing development dependency: $dependency" >&2
        exit 1
    fi
done
if [[ ! -x "$qml_linter" ]]; then
    echo "Missing QML linter: $qml_linter" >&2
    exit 1
fi
test_home="$(mktemp -d)"
trap 'rm -rf "$test_home"' EXIT
mkdir -m 700 "$test_home/runtime"
./scripts/pre-push
HOME="$test_home" XDG_CONFIG_HOME="$test_home/.config" XDG_DATA_HOME="$test_home/.local/share" XDG_STATE_HOME="$test_home/.local/state" XDG_RUNTIME_DIR="$test_home/runtime" python3 -m unittest discover -s tests -v
if ! quickshell --version >/dev/null; then
    echo 'Cannot validate Quickshell imports until the installed Qt/Quickshell versions match.' >&2
    exit 1
fi
qml_linter="${QMLLINT:-/usr/lib/qt6/bin/qmllint}"
# The installed GlobalShortcut metadata names an internal PostReloadHook type
# that qmllint cannot resolve. Keep this upstream metadata exception on the
# tiny native shortcut wrapper only; all other QML keeps strict import checks.
"$qml_linter" --max-warnings 0 --import disable -i shell/qmldir -i shell/theme/qmldir -I /usr/lib/qt6/qml -I shell shell/core/NativeShortcut.qml
qml_sources=()
mapfile -t all_qmls < <(find shell -name "*.qml")
for qml_source in "${all_qmls[@]}"; do
    if [[ "$qml_source" != "shell/core/NativeShortcut.qml" ]]; then
        qml_sources+=("$qml_source")
    fi
done
# Arch's optional Quickshell native modules are not always loadable by qmllint;
# retain those import diagnostics without letting toolchain-only warnings fail CI.
"$qml_linter" --max-warnings 0 --import info --unqualified info --Quick.layout-positioning info --uncreatable-type info --literal-constructor info --id-shadows-member info --missing-property info -i shell/qmldir -i shell/theme/qmldir -I /usr/lib/qt6/qml -I shell "${qml_sources[@]}"
